// CFM Workplace database schema.
//
// The User / Session / Account / Verification models follow the layout
// Better Auth expects (core tables + the `username` plugin + our `role` field).
// Everything below them is CFM Workplace's own domain model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// ADMIN is the company owner (exactly one): sees and controls everything.
/// MANAGER runs one or more teams. MEMBER is an employee on one team.
enum Role {
  /// The owner (exactly one).
  ADMIN
  /// Works across every team: assigns, manages and reviews any team's work.
  HR
  MANAGER
  /// An employee.
  MEMBER
}

/// Stored workflow state. "Overdue" is never stored: it is derived from
/// `dueAt` and a status other than COMPLETED.
enum TaskStatus {
  PENDING
  IN_PROGRESS
  /// Handed in by the assignee, waiting for the reviewer to pass or fail it.
  SUBMITTED
  /// Passed by the reviewer (or completed before reviews existed).
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  UPDATED
  REASSIGNED
  STARTED
  COMPLETED
  REOPENED
  ARCHIVED
  RESTORED
  SUBTASK_ADDED
  SUBMITTED
  PASSED
  FAILED
}

// ─── Auth (Better Auth) ─────────────────────────────────────────────────────

model User {
  id              String   @id
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  username        String?  @unique
  displayUsername String?
  /// Never accepted from sign-up input; only changed by server-side admin tooling.
  role            Role     @default(MEMBER)
  /// Set when the owner deletes the account. The person can't sign in any
  /// more, but their tasks and history stay, tagged "Deleted".
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  managedTeams      Team[]             @relation("TeamManager")
  memberships       TeamMember[]       @relation("MembershipUser")
  addedMembers      TeamMember[]       @relation("MembershipAddedBy")
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  taskActivities    TaskActivity[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth rate-limit counters (sign-in / sign-up throttling).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Notifications ──────────────────────────────────────────────────────────

/// One phone or browser that turned on notifications. `endpoint` is the
/// address the browser's push service (Google, Apple, Mozilla) gave it.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Teams ──────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// The team's manager (a MANAGER, or the owner running a team directly).
  managerId   String   @map("ownerId")
  manager     User     @relation("TeamManager", fields: [managerId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
  tasks   Task[]

  @@index([managerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?    @relation("MembershipAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  /// An employee belongs to at most one team.
  @@unique([userId])
  @@map("team_members")
}

// ─── Tasks ──────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueAt       DateTime

  teamId      String
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Set on a subtask: a manager splitting a bigger task among their team.
  /// One level only (a subtask never has subtasks of its own).
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  // Lifecycle timestamps. Always set by the server, never by client input.
  assignedAt     DateTime  @default(now())
  startedAt      DateTime?
  /// When the assignee last handed the work in; on-time is judged by this.
  submittedAt    DateTime?
  /// When the reviewer passed it. Only passed work counts as done.
  completedAt    DateTime?
  /// The assignee's note on what they delivered.
  completionNote String?
  /// The reviewer's latest feedback (required when failing).
  reviewNote     String?
  /// How many times the reviewer sent it back.
  timesFailed    Int       @default(0)
  archivedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities TaskActivity[]

  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([dueAt])
  @@index([parentId])
  @@map("tasks")
}

/// Append-only history of everything that happens to a task.
model TaskActivity {
  id         String           @id @default(cuid())
  taskId     String
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type       TaskActivityType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  /// Extra context, e.g. changed fields or previous/new assignee ids.
  details    Json?
  createdAt  DateTime         @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
  @@map("task_activities")
}
