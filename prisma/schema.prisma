// CFM Workplace database schema.
//
// The User / Session / Account / Verification models follow the layout
// Better Auth expects (core tables + the `username` plugin + our `role` field).
// Everything below them is CFM Workplace's own domain model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// ADMIN is the company owner (exactly one): sees and controls everything.
/// MANAGER runs one or more teams. MEMBER is an employee on one team.
enum Role {
  /// The owner (exactly one).
  ADMIN
  /// Works across every team: assigns, manages and reviews any team's work.
  HR
  MANAGER
  /// An employee.
  MEMBER
}

/// Stored workflow state. "Overdue" is never stored: it is derived from
/// `dueAt` and a status other than COMPLETED.
enum TaskStatus {
  PENDING
  IN_PROGRESS
  /// Handed in by the assignee, waiting for the reviewer to pass or fail it.
  SUBMITTED
  /// Passed by the reviewer (or completed before reviews existed).
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  UPDATED
  REASSIGNED
  STARTED
  COMPLETED
  REOPENED
  ARCHIVED
  RESTORED
  SUBTASK_ADDED
  SUBMITTED
  PASSED
  FAILED
}

enum AttachmentKind {
  IMAGE
  VIDEO
  FILE
}

/// A private conversation with the owner.
enum ConversationKind {
  /// "Talk to the owner": someone raises a problem. Only they and the owner see it.
  OWNER_CASE
  /// One HR person's private channel with the owner: meeting reports and messages.
  HR_DESK
}

enum CaseStatus {
  /// Raised, the owner hasn't replied yet.
  OPEN
  /// The owner has replied.
  IN_DISCUSSION
  /// The owner closed it. A new message from whoever raised it reopens it.
  RESOLVED
  /// Taken back by whoever raised it, within minutes of sending (see MESSAGE_DELETE_WINDOW_MS).
  WITHDRAWN
}

enum CaseCategory {
  COLLEAGUE
  MANAGER
  WORKLOAD
  CONDUCT
  OTHER
}

enum CaseUrgency {
  NORMAL
  URGENT
}

// ─── Auth (Better Auth) ─────────────────────────────────────────────────────

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  /// Never accepted from sign-up input; only changed by server-side admin tooling.
  role            Role      @default(MEMBER)
  /// Set when the owner deletes the account. The person can't sign in any
  /// more, but their tasks and history stay, tagged "Deleted".
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  managedTeams      Team[]                @relation("TeamManager")
  memberships       TeamMember[]          @relation("MembershipUser")
  addedMembers      TeamMember[]          @relation("MembershipAddedBy")
  assignedTasks     Task[]                @relation("TaskAssignee")
  createdTasks      Task[]                @relation("TaskCreator")
  taskActivities    TaskActivity[]
  pushSubscriptions PushSubscription[]
  attachments       Attachment[]
  conversations     Conversation[]        @relation("ConversationCreator")
  casesAbout        Conversation[]        @relation("ConversationAbout")
  messages          ConversationMessage[]
  conversationReads ConversationRead[]
  meetingsAttended  MeetingReport[]       @relation("MeetingAttendees")
  chatsAsFirst      EmployeeChat[]        @relation("ChatFirst")
  chatsAsSecond     EmployeeChat[]        @relation("ChatSecond")
  chatMessages      EmployeeChatMessage[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth rate-limit counters (sign-in / sign-up throttling).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Notifications ──────────────────────────────────────────────────────────

/// One phone or browser that turned on notifications. `endpoint` is the
/// address the browser's push service (Google, Apple, Mozilla) gave it.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Teams ──────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// The team's manager (a MANAGER, or the owner running a team directly).
  managerId   String   @map("ownerId")
  manager     User     @relation("TeamManager", fields: [managerId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
  tasks   Task[]

  @@index([managerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?    @relation("MembershipAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  /// An employee belongs to at most one team.
  @@unique([userId])
  @@map("team_members")
}

// ─── Tasks ──────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueAt       DateTime

  teamId      String
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Set on a subtask: a manager splitting a bigger task among their team.
  /// One level only (a subtask never has subtasks of its own).
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  // Lifecycle timestamps. Always set by the server, never by client input.
  assignedAt     DateTime  @default(now())
  startedAt      DateTime?
  /// When the assignee last handed the work in; on-time is judged by this.
  submittedAt    DateTime?
  /// When the reviewer passed it. Only passed work counts as done.
  completedAt    DateTime?
  /// The assignee's note on what they delivered.
  completionNote String?
  /// The reviewer's latest feedback (required when failing).
  reviewNote     String?
  /// How many times the reviewer sent it back.
  timesFailed    Int       @default(0)
  archivedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities TaskActivity[]

  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([dueAt])
  @@index([parentId])
  @@map("tasks")
}

/// Append-only history of everything that happens to a task.
model TaskActivity {
  id         String           @id @default(cuid())
  taskId     String
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type       TaskActivityType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  /// Extra context, e.g. changed fields or previous/new assignee ids.
  details    Json?
  createdAt  DateTime         @default(now())

  /// Photos and videos handed in with a submission or a review verdict.
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([actorId])
  @@map("task_activities")
}

// ─── Attachments ────────────────────────────────────────────────────────────

/// A photo or video someone uploaded, kept in the private Blob store
/// `cfm-attachments` and only ever served through `/api/files/[id]`, which
/// checks the viewer may see what it's attached to.
///
/// The browser uploads straight to storage first, leaving a draft (no
/// parent). Saving the submission or review links the drafts; drafts nobody
/// used are removed after a day.
model Attachment {
  id          String         @id @default(cuid())
  uploaderId  String
  uploader    User           @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  kind        AttachmentKind
  /// The file's name on the uploader's device, shown in the viewer.
  name        String
  contentType String
  size        Int
  /// Where it sits in the Blob store. Never sent to the browser.
  pathname    String         @unique

  /// What it's attached to: a submission or review step, or a message.
  /// Both are null while it's a draft.
  activityId String?
  activity   TaskActivity?        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  messageId  String?
  message    ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chatMessageId String?
  chatMessage EmployeeChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([activityId])
  @@index([messageId])
  @@index([chatMessageId])
  @@index([uploaderId, createdAt])
  @@map("attachments")
}

// ─── Private conversations with the owner ──────────────────────────────────

/// A private thread between one person and the owner: a case someone raised
/// ("Talk to the owner"), or an HR person's desk with the owner. Only its
/// creator and the owner can ever see it (`canSeeConversation`); the person a
/// case is about never does.
model Conversation {
  id        String           @id @default(cuid())
  kind      ConversationKind
  /// Who raised the case, or the HR person the desk belongs to.
  creatorId String
  creator   User             @relation("ConversationCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  // Cases only.
  subject     String?
  category    CaseCategory?
  urgency     CaseUrgency?
  /// Who the problem is with (optional). Never shown to them.
  aboutUserId String?
  aboutUser   User?         @relation("ConversationAbout", fields: [aboutUserId], references: [id], onDelete: SetNull)
  status      CaseStatus    @default(OPEN)
  resolvedAt  DateTime?

  /// HR desks only: "hr:<userId>", so each HR person has exactly one.
  deskKey String? @unique

  /// For unread markers: when the last message came, and from whom.
  lastMessageAt       DateTime @default(now())
  lastMessageAuthorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]
  reads    ConversationRead[]

  @@index([kind, lastMessageAt])
  @@index([creatorId])
  @@map("conversations")
}

model ConversationMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body           String                @default("")
  /// A reply quoting an earlier message (e.g. the owner asking about a report).
  replyToId      String?
  replyTo        ConversationMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ConversationMessage[] @relation("MessageReplies")
  /// Set when the sender deleted it within the allowed minutes. The body and
  /// files are removed; a "This message was deleted" placeholder stays.
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())

  attachments Attachment[]
  report      MeetingReport?

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// A meeting report HR sends the owner, shown as a card in HR's desk.
model MeetingReport {
  id          String              @id @default(cuid())
  messageId   String              @unique
  message     ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  meetingDate DateTime            @db.Date
  title       String
  attendees   User[]              @relation("MeetingAttendees")
  discussed   String
  decisions   String              @default("")
  actionItems String              @default("")

  @@map("meeting_reports")
}

/// How far each person has read a conversation ("Seen", unread badges).
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime

  @@id([conversationId, userId])
  @@map("conversation_reads")
}

/// Company direct messages. Only these two participants may read the thread.
/// Kept separate from confidential owner cases and HR meeting reports.
model EmployeeChat {
  id String @id @default(cuid())
  firstId String
  first User @relation("ChatFirst", fields: [firstId], references: [id], onDelete: Restrict)
  secondId String
  second User @relation("ChatSecond", fields: [secondId], references: [id], onDelete: Restrict)
  firstReadAt DateTime?
  secondReadAt DateTime?
  lastMessageAt DateTime @default(now())
  createdAt DateTime @default(now())
  messages EmployeeChatMessage[]

  @@unique([firstId, secondId])
  @@index([secondId, lastMessageAt])
  @@map("employee_chats")
}

model EmployeeChatMessage {
  id String @id @default(cuid())
  chatId String
  chat EmployeeChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body String @default("")
  createdAt DateTime @default(now())
  deletedAt DateTime?
  attachments Attachment[]

  @@index([chatId, createdAt, id])
  @@map("employee_chat_messages")
}
