# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL="postgresql://cfm:cfm_dev_password@localhost:5433/cfm_manager?schema=public"

# Better Auth: a long random string (e.g. openssl rand -base64 32) and the app's base URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Timezone used to display dates (IANA name)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
