# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL="postgresql://cfm:cfm_dev_password@localhost:5433/cfm_manager?schema=public"

# Better Auth: a long random string (e.g. openssl rand -base64 32) and the app's base URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Timezone used to display dates (IANA name)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Email (password reset) over SMTP. Without SMTP settings, development prints
# emails to the server console instead of sending them. Production needs them.
#   Gmail:     SMTP_HOST="smtp.gmail.com"      SMTP_PORT="465"  user = the Gmail address, password = an App Password
#   Hostinger: SMTP_HOST="smtp.hostinger.com"  SMTP_PORT="465"  user = the full mailbox address, password = mailbox password
# EMAIL_FROM must use the same address as SMTP_USER.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CFM Workplace <you@example.com>"
